{
  "name": "eleventy-plugin-glossary",
  "version": "0.1.0",
  "description": "Eleventy plugin that adds a glossary shortcode/filter to auto-link and define terms in your content.",
  "main": "lib/glossary.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo:build": "cd demo && eleventy",
    "demo:index": "cd demo && pagefind --site _site --output-path _site/pagefind-glossary",
    "demo": "npm run demo:build && npm run demo:index"
  },
  "keywords": [
    "eleventy",
    "eleventy-plugin",
    "11ty",
    "glossary"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@11ty/eleventy": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "pagefind": "^1.5.2"
  },
  "files": [
    "lib"
  ]
}
